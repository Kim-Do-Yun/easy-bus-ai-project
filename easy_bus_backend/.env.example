OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
WHISPER_PATH=models/whisper/small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STOPS_PATH=data/processed/stops.json
ROUTES_PATH=data/processed/routes.json
AI_TIMEOUT=120
MAX_AUDIO_BYTES=10485760
MAX_AUDIO_SECONDS=60

# 네이버 서버 API 설정 (앱용 지도 Client ID와 별도 관리)
NAVER_API_KEY_ID=
NAVER_API_KEY=

# ODsay 대중교통 경로 API 설정
ODSAY_API_KEY=

# TAGO 버스정보 API 설정 (원주시 도시코드는 확인 후 입력)
TAGO_SERVICE_KEY=
TAGO_CITY_CODE=

# 향후 연동에 사용할 서비스 지역 설정
SERVICE_REGION=wonju

# 외부 API 시간 제한 및 메모리 캐시 유효기간 (초)
TRANSIT_HTTP_TIMEOUT=10
TRANSIT_REQUEST_SECONDS=100
TAGO_CACHE_SECONDS=3600
TAGO_ARRIVAL_CACHE_SECONDS=15
ODSAY_CACHE_SECONDS=300

# 단일 서버 프로세스의 하루 호출 예산 (검색과 형상 조회 합산, 재시작 시 초기화)
ODSAY_DAILY_CALL_LIMIT=30

# 이름이 같은 정류장을 대조할 최대 좌표 거리 (미터)
STOP_MATCH_RADIUS_M=60
